{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022"], "outDir": "dist", "rootDir": "src", "strict": true,
    "noUncheckedIndexedAccess": true, "declaration": true,
    "verbatimModuleSyntax": true, "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/worker.ts"]
}
