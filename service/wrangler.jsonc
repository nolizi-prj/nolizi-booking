// Cloudflare deployment of the scheduling service. See src/worker.ts for the
// architecture; the Node entry (src/server.ts) is unaffected by this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pumasi-booking",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "booking.nolizi.com", "custom_domain": true }],
  // Migrations ship inside the bundle as text (.sql is Text by default rule).
  "durable_objects": {
    "bindings": [
      { "name": "PUMASI", "class_name": "PumasiService" },
      { "name": "DIRECTORY", "class_name": "PumasiDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PumasiService"] },
    { "tag": "v2", "new_sqlite_classes": ["PumasiDirectory"] }
  ],
  "observability": { "enabled": true },
  "vars": {
    "BASE_URL": "https://booking.nolizi.com",
    // Public launch: verified Google/Microsoft identities and email-verified
    // signups may create accounts without an invite. The explicit ceiling
    // remains a deliberate abuse/cost boundary and can be raised separately.
    "PUBLIC_SIGNUP": "true",
    "MAX_OWNER_ACCOUNTS": "1000",
    "MAIL_FROM": "Pumasi Booking <no-reply@pumasi.ai>",
    // The Workspace user the mailer service account impersonates (DWD).
    // no-reply@pumasi.ai is a registered send-as alias of this account.
    "GMAIL_IMPERSONATE": "admin@pumasi.ai"
  }
  // Secrets (GMAIL_SA_KEY, BOOTSTRAP_INVITE) via:  wrangler secret put NAME
}
