// Cloudflare deployment of the scheduling service. See src/worker.ts for the
// architecture; the Node entry (src/server.ts) is unaffected by this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pumasi-booking",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "booking.pumasi.ai", "custom_domain": true }],
  // Migrations ship inside the bundle as text (.sql is Text by default rule).
  "durable_objects": {
    "bindings": [{ "name": "PUMASI", "class_name": "PumasiService" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PumasiService"] }],
  "observability": { "enabled": true },
  "vars": {
    "BASE_URL": "https://booking.pumasi.ai",
    "MAIL_FROM": "Pumasi Booking <no-reply@pumasi.ai>",
    // The Workspace user the mailer service account impersonates (DWD).
    // no-reply@pumasi.ai is a registered send-as alias of this account.
    "GMAIL_IMPERSONATE": "admin@pumasi.ai"
  }
  // Secrets (GMAIL_SA_KEY, BOOTSTRAP_INVITE) via:  wrangler secret put NAME
}
