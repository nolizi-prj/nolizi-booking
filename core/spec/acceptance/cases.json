{
  "suite": "SPEC-0001 scheduling-core acceptance",
  "version": "1.1.0",
  "frozen_at_approval": true,
  "note": "Language-neutral conformance suite. Each implementation ships a thin runner that feeds `request` to compute_slots/book and compares against `expect`. Runners are ordinary risk; this file is the truth.",
  "environment": {
    "tzdata": "2026a",
    "on_mismatch": "FAIL_LOUDLY",
    "rationale": "SPEC.md section 6 / DEBT.md D-006. A skipped timezone test is worse than a failing one."
  },
  "defaults": {
    "buffer_before_minutes": 0,
    "buffer_after_minutes": 0,
    "minimum_notice_minutes": 0,
    "maximum_horizon_days": 3650,
    "max_bookings_per_day": null,
    "bookings_per_local_date": {},
    "date_overrides": [],
    "busy": []
  },
  "slot_cases": [
    {
      "id": "C-001",
      "clause": "S5",
      "description": "Baseline. Monday 09:00-11:00 EDT, hourly slots.",
      "request": {
        "owner_timezone": "America/New_York",
        "availability": [
          {
            "weekday": "MO",
            "start": "09:00",
            "end": "11:00"
          }
        ],
        "duration_minutes": 60,
        "granularity_minutes": 60,
        "query": {
          "from": "2026-06-01T00:00:00Z",
          "to": "2026-06-02T00:00:00Z"
        },
        "now": "2026-06-01T00:00:00Z"
      },
      "expect": {
        "slots": [
          {
            "start": "2026-06-01T13:00:00Z",
            "end": "2026-06-01T14:00:00Z"
          },
          {
            "start": "2026-06-01T14:00:00Z",
            "end": "2026-06-01T15:00:00Z"
          }
        ]
      }
    },
