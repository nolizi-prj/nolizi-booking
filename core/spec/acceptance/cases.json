    {
      "id": "C-022",
      "clause": "S3",
      "description": "A zone that skips an ENTIRE CALENDAR DAY. Pacific/Apia had no 2011-12-30 when it crossed the date line. Comparing only the clock face reads this as an ambiguous hour, because the same wall time exists on the adjacent date, and offers slots that never occurred. Added 2026-08-02. Found by adversarial code review of the first implementation, not by this suite — the suite is a floor and this is what it had missed.",
      "request": {
        "owner_timezone": "Pacific/Apia",
        "availability": [
          {
            "weekday": "FR",
            "start": "09:00",
            "end": "17:00"
          }
        ],
        "duration_minutes": 60,
