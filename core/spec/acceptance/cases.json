      "id": "C-021",
      "clause": "S12",
      "description": "Determinism. The same request is evaluated twice in the same process and again in a fresh one; all three responses must be BYTE-identical, including diagnostic order. Catches ambient clock reads, map-iteration order, and locale-dependent formatting.",
      "repeat": {
        "in_process": 2,
        "fresh_process": 1,
        "compare": "bytes"
      },
      "request": {
        "owner_timezone": "America/New_York",
        "availability": [
          {
            "weekday": "SU",
            "start": "01:00",
            "end": "03:00"
          }
        ],
        "date_overrides": [
