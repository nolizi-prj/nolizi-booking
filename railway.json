{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "npm ci && npm run build --workspaces --if-present" },
  "deploy": {
    "startCommand": "node apps/service/dist/server.js",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE"
  }
}
